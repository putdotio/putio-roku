# Optional local overrides for sideloading and packaging.
# Build-only commands such as `pnpm verify` do not require this file.
# Copy to `.env` or `.env.local` (or export variables directly in your shell).

ROKU_DEV_TARGET="192.0.2.10"
ROKU_DEV_PASSWORD=""

# Optional put.io CLI harness auth (defaults to profile "default" and .putio-cli/default.json).
PUTIO_CLI_PROFILE=""
PUTIO_CLI_CONFIG_PATH=""
PUTIO_TEST_USERNAME=""
PUTIO_TEST_PASSWORD=""
PUTIO_TEST_TOTP_REFERENCE=""
PUTIO_CLIENT_ID_FIRST_PARTY=""
PUTIO_CLIENT_SECRET_FIRST_PARTY=""

# Optional public Sentry DSN for local packaging. Release builds set it from the
# PUTIO_ROKU_SENTRY_DSN repository variable; leave it empty to disable reporting.
PUTIO_ROKU_SENTRY_DSN=""

# Optional files-flow folder (zero-based row index); flows default to roku-files-fixture.
FILES_FOLDER_NAME=
FILES_FOLDER_INDEX=

# Optional content IDs required by `pnpm roku live-test-flow-full` and player UI tests.
PLAYBACK_CONTENT_ID=""
IMAGE_CONTENT_ID=""
AUDIO_CONTENT_ID=""
SUBTITLE_CONTENT_ID=""
