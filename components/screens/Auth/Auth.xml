<?xml version="1.0" encoding="utf-8" ?>
<component name="AuthScreen" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/shared/UiMetrics/UiMetrics.brs" />
  <script type="text/brightscript" uri="pkg:/source/DesignTokens.brs" />
  <script type="text/brightscript" uri="pkg:/components/shared/DialogStyle/DialogStyle.brs" />
  <script type="text/brightscript" uri="pkg:/components/shared/KeyUtils.brs" />
  <script type="text/brightscript" uri="pkg:/source/BuildConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/shared/Typography/Typography.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/Auth/Auth.brs" />

  <interface>
    <field id="params" type="assocarray" />
    <field id="routeShown" type="boolean" alwaysNotify="true" />
    <field id="routeHidden" type="boolean" alwaysNotify="true" />
    <field id="token" type="string" value="" />
    <field id="showExitAppDialog" type="boolean" value="false" alwaysNotify="true" />
    <field id="preview" type="assocarray" onChange="onPreviewChange" />
  </interface>

  <children>
    <Rectangle id="background" />

    <Group id="stage">
      <Group id="stageReel" />
    </Group>

    <Label
      id="title"
      text="Sign in to put.io"
      height="60"
      horizAlign="center"
      vertAlign="center"
    />

    <LayoutGroup
      id="phoneColumn"
      layoutDirection="vert"
      horizAlignment="center"
      itemSpacings="[24, 24]"
    >
      <Label id="phoneTitle" text="With your phone" height="45" vertAlign="center" />
      <Group id="qrCard">
        <Poster
          id="qrCardBackground"
          width="345"
          height="345"
          uri="pkg:/images/auth/auth-rounded-33.9.png"
        />
        <Poster
          id="qrCode"
          translation="[24, 24]"
          width="297"
          height="297"
          loadDisplayMode="scaleToFit"
          visible="false"
        />
      </Group>
      <Label id="phoneCaption" text="Scan with your camera and approve." height="36" vertAlign="center" />
    </LayoutGroup>

    <Rectangle id="dividerTop" width="3" height="249" />
    <Label
      id="orLabel"
      text="or"
      width="123"
      height="45"
      horizAlign="center"
      vertAlign="center"
    />
    <Rectangle id="dividerBottom" width="3" height="249" />

    <LayoutGroup
      id="browserColumn"
      layoutDirection="vert"
      horizAlignment="center"
      itemSpacings="[24, 24, 24, 24]"
    >
      <Label id="browserTitle" text="In a browser" height="45" vertAlign="center" />

      <LayoutGroup id="browserInstruction" layoutDirection="horiz" itemSpacings="[9, 9]">
        <Label id="instructionLead" text="Go to" height="45" vertAlign="center" />
        <Label id="instructionUrl" text="put.io/link" height="45" vertAlign="center" />
        <Label id="instructionTail" text="and enter" height="45" vertAlign="center" />
      </LayoutGroup>

      <Group id="status">
        <Rectangle id="statusFrame" width="720" height="45" />
        <Poster
          id="statusSpinner"
          width="27"
          height="27"
          scaleRotateCenter="[13.5, 13.5]"
          loadDisplayMode="scaleToFit"
          uri="pkg:/images/Spinner.png"
        />
        <Label id="statusLabel" horizAlign="center" vertAlign="center" />
      </Group>

      <LayoutGroup id="codeTiles" layoutDirection="horiz" itemSpacings="[9]" />

      <Group id="newCodeButton">
        <Poster
          id="newCodeBackground"
          width="288"
          height="66"
          uri="pkg:/images/auth/auth-pill.png"
        />
        <LayoutGroup
          layoutDirection="horiz"
          horizAlignment="center"
          vertAlignment="center"
          translation="[144, 33]"
          itemSpacings="[12]"
        >
          <Poster id="newCodeIcon" width="30" height="30" uri="pkg:/images/icons/refresh.png" />
          <Label id="newCodeLabel" text="Get a new code" height="66" vertAlign="center" />
        </LayoutGroup>
      </Group>
    </LayoutGroup>

    <Animation id="stageSlide" duration="0.45" easeFunction="inOutCubic">
      <Vector2DFieldInterpolator id="stageSlideInterpolator" key="[0.0, 1.0]" fieldToInterp="stageReel.translation" />
    </Animation>

    <Animation id="spinnerSpin" duration="1" repeat="true" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, -6.2832]" fieldToInterp="statusSpinner.rotation" />
    </Animation>
  </children>
</component>
